# ============================================================
#  2Syria server — copy this file to ".env" and fill it in
#  (on Render: add each line under Environment > Environment Variables)
# ============================================================

# ---- Server ----
# Render sets PORT automatically; 3000 is used locally.
PORT=3000

# ---- Database ----
# Either DATABASE_URL (MongoDB Atlas / Render) ...
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/2syria?retryWrites=true&w=majority
# ... or leave DATABASE_URL empty and use a local / Docker MongoDB:
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=2syria
MONGO_HOST=localhost
MONGO_HOST_PORT=27017

# Secret used to sign the users' login tokens — any long random string
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# ---- Account recovery emails (Gmail + App Password) ----
# Gmail needs 2-step verification on, then create an App Password:
# Google Account > Security > App passwords
EMAIL=your_address@gmail.com
USER_NAME=your_address@gmail.com
APP_PASSWORD=your_16_char_app_password

# ---- AI image search (the Flask service) ----
# Full URL of the similarity endpoint. If it is empty or the service is down,
# "search by photo" answers: "the AI image search service is not available right now".
SIMILARITY_URL=https://your-ai-service.onrender.com/api/models/get-similarities

# JWT the Node server sends to the AI service (Authorization: Bearer ...).
# It must be signed with the AI service's SERVER_TOKEN_SECRET, e.g.:
#   node -e "console.log(require('jsonwebtoken').sign({sub:'2syria-server',type:'access'}, 'SAME_SECRET_AS_AI_SERVICE'))"
SERVER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx.xxxxx

# How long to wait for the AI service before giving up (ms).
# A sleeping free Render service can take ~1 minute to wake up.
AI_TIMEOUT_MS=60000

# ---- Place photos on Cloudflare R2 ----
# The server reads photos from the bucket with these keys and sends them to the browser,
# so the bucket can stay PRIVATE (no public r2.dev URL needed).
# Needed on Render AND for "npm run upload-images".
# Cloudflare > R2 > Manage R2 API Tokens > token with "Object Read & Write" on this bucket.
# If these are empty, photos are served from server/data/images (local development).
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=2syria-images

# ---- Google Places photos (only used by /api/place/get-place-photo) ----
KEY=your_google_maps_api_key

# ---- Optional ----
# Where the built frontend lives (default: ../browser/dist)
# CLIENT_DIST=../browser/dist

# Google OAuth — not wired to any route yet, can stay empty
# CLIENT_ID=
# CLIENT_SECRET=

# ---- Fake data (npm run seed) ----
# Password given to every fake user (default: Syria2026!)
# SEED_PASSWORD=Syria2026!
